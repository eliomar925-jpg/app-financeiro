  "glossario": [
    {
      "termo": "Resultado primário",
      "definicao": "Receitas menos despesas primárias, antes dos juros da dívida."
    },
    {
      "termo": "Resultado nominal",
      "definicao": "Resultado fiscal que incorpora o resultado primário e os juros nominais."
    },
    {
      "termo": "Dívida bruta",
      "definicao": "Estoque bruto de obrigações do governo geral segundo a metodologia do Banco Central."
    },
    {
      "termo": "Ponto percentual",
      "definicao": "Diferença aritmética entre duas taxas expressas em porcentagem."
    },
    {
      "termo": "Ideb",
      "definicao": "Índice que combina fluxo escolar e desempenho em avaliações da educação básica."
    },
    {
      "termo": "Taxa por 100 mil",
      "definicao": "Medida padronizada que permite comparar eventos entre populações de tamanhos diferentes."
    },
    {
      "termo": "Siconfi",
      "definicao": "Sistema de Informações Contábeis e Fiscais do Setor Público Brasileiro, usado pelo Tesouro Nacional para receber e divulgar informações fiscais e contábeis de estados e municípios."
    },
    {
      "termo": "PIB nominal",
      "definicao": "Valor dos bens e serviços finais a preços correntes. Não mede isoladamente crescimento real."
    },
    {
      "termo": "PIB real",
      "definicao": "Variação do volume da produção, descontadas as mudanças de preços."
    },
    {
      "termo": "PIB per capita",
      "definicao": "PIB dividido pela população de referência da mesma metodologia e ano."
    },
    {
      "termo": "IPCA",
      "definicao": "Índice de Preços ao Consumidor Amplo do IBGE. O acumulado utiliza composição das variações, não sua soma."
    },
    {
      "termo": "Selic",
      "definicao": "Taxa de juros do mercado de títulos públicos. A taxa efetiva difere da meta definida pelo Copom."
    },
    {
      "termo": "Desocupação",
      "definicao": "Pessoas sem trabalho, disponíveis e que procuraram trabalho segundo os critérios da PNAD Contínua."
    },
    {
      "termo": "Trimestre móvel",
      "definicao": "Período de três meses consecutivos. Períodos mensais consecutivos compartilham dois meses."
    },
    {
      "termo": "Rendimento real",
      "definicao": "Rendimento corrigido pelo deflator informado pela pesquisa; não confundir com valor nominal."
    },
    {
      "termo": "Estoque",
      "definicao": "Valor em uma data, como a dívida ao final do mês."
    },
    {
      "termo": "Fluxo",
      "definicao": "Valor acumulado durante um período, como juros no mês ou em 12 meses."
    },
    {
      "termo": "NFSP",
      "definicao": "Necessidades de Financiamento do Setor Público. Nas séries apresentadas, déficit positivo e superávit negativo."
    },
    {
      "termo": "Cadastro Único",
      "definicao": "Registro administrativo de famílias; inscrição não implica recebimento do Bolsa Família."
    },
    {
      "termo": "Homicídios ocultos",
      "definicao": "Estimativa da fonte para mortes violentas classificadas em outras causas; permanece separada dos registros observados."
    }
  ]
}
